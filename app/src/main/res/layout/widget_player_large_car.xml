<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="5dp" android:gravity="center"
    android:background="@drawable/widget_bg">
    <!-- Ces trois TextView sont modifiables visuellement dans Android Studio. -->
    <LinearLayout android:id="@+id/wMetadata" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1.1"
        android:orientation="vertical" android:gravity="center"
android:textAlignment="center"
        android:paddingStart="8dp" android:paddingEnd="8dp">
        <TextView android:id="@+id/wArtist" android:layout_width="match_parent"
            android:layout_height="0dp" android:layout_weight="1"
            android:singleLine="true" android:ellipsize="end"
            android:fontFamily="@font/lobster_two_bold" android:textSize="17sp"
            android:textColor="#EFD08E" android:gravity="center"
android:textAlignment="center"
            tools:text="Interprète : The Doors" />
        <TextView android:id="@+id/wAlbum" android:layout_width="match_parent"
            android:layout_height="0dp" android:layout_weight="1"
            android:singleLine="true" android:ellipsize="end"
            android:fontFamily="@font/lobster_two_bold" android:textSize="16sp"
            android:textColor="#DDB563" android:gravity="center"
android:textAlignment="center"
            tools:text="Album : L.A. Woman" />
        <TextView android:id="@+id/wTitle" android:layout_width="match_parent"
            android:layout_height="0dp" android:layout_weight="1"
            android:singleLine="true" android:ellipsize="end"
            android:fontFamily="@font/lobster_two_bold" android:textSize="18sp"
            android:textColor="#FFEBBA" android:gravity="center"
android:textAlignment="center"
            tools:text="Titre : Riders on the Storm" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:id="@+id/wPrevAlbum" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:src="@drawable/button_album_prev" android:scaleType="fitCenter" android:contentDescription="Album précédent" android:padding="1dp" />
        <ImageView android:id="@+id/wPrev" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.1" android:src="@drawable/button_track_prev" android:scaleType="fitCenter" android:contentDescription="Piste précédente" android:padding="1dp" />
        <ImageView android:id="@+id/wPlay" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.45" android:src="@drawable/button_play_pause" android:scaleType="fitCenter" android:contentDescription="Lecture et pause" android:padding="1dp" />
        <ImageView android:id="@+id/wNext" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.1" android:src="@drawable/button_track_next" android:scaleType="fitCenter" android:contentDescription="Piste suivante" android:padding="1dp" />
        <ImageView android:id="@+id/wNextAlbum" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:src="@drawable/button_album_next" android:scaleType="fitCenter" android:contentDescription="Album suivant" android:padding="1dp" />
    </LinearLayout>
</LinearLayout>
